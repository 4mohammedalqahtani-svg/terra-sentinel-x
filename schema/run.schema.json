{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/4mohammedalqahtani-svg/terra-sentinel-x/schema/run.schema.json",
  "title": "TERRA-SENTINEL X run metadata (run.json)",
  "description": "One analysis run: the before/after scene pair, the files produced, and where they sit on the map. File paths are relative to the folder that holds run.json.",
  "type": "object",
  "required": [
    "run_id",
    "aoi_name",
    "crs",
    "bounds",
    "before",
    "after",
    "change_map",
    "changes",
    "generated_at"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Lowercase id, also the folder name under outputs/."
    },
    "aoi_name": {
      "type": "string",
      "description": "Human-readable area of interest, e.g. 'Jeddah, Saudi Arabia'."
    },
    "event": {
      "type": "string",
      "description": "Optional flood event label, e.g. 'Jeddah flash flood, Nov 2026'."
    },
    "demo": {
      "type": "boolean",
      "description": "true when outputs are synthetic placeholders, not real NISAR analysis. The frontend must show a banner."
    },
    "crs": {
      "const": "EPSG:4326"
    },
    "bounds": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      },
      "description": "[west, south, east, north] in degrees. PNG overlays are stretched to exactly these bounds."
    },
    "before": {
      "$ref": "#/$defs/scene"
    },
    "after": {
      "$ref": "#/$defs/scene"
    },
    "change_map": {
      "type": "object",
      "required": [
        "png"
      ],
      "properties": {
        "png": {
          "type": "string",
          "description": "RGBA overlay, transparent where nothing changed."
        },
        "geotiff": {
          "type": "string"
        }
      }
    },
    "doubt_map": {
      "type": "object",
      "description": "Optional Smart Doubt raster from validation/. Value = number of tested thresholds passed (PNG: 1 yellow, 2 orange, 3 magenta).",
      "properties": {
        "png": {
          "type": "string"
        },
        "geotiff": {
          "type": "string"
        }
      }
    },
    "changes": {
      "type": "string",
      "description": "Path to changes.geojson."
    },
    "method": {
      "type": "object",
      "description": "Optional summary of the algorithm used (shown in the About panel).",
      "properties": {
        "name": {
          "type": "string"
        },
        "threshold_db": {
          "type": "number"
        },
        "thresholds_tested_db": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "speckle_filter": {
          "type": "string"
        }
      }
    },
    "summary": {
      "type": "object",
      "description": "Filled in by backend/pipeline.py from changes.geojson.",
      "properties": {
        "n_changes": {
          "type": "integer",
          "minimum": 0
        },
        "total_area_km2": {
          "type": "number",
          "minimum": 0
        },
        "n_high_doubt": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "description": "e.g. EXPLORATORY_NOT_VALIDATED. Show it next to the results."
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Plain-English caveats shown in the About / Smart Doubt panel."
    },
    "validation": {
      "type": "object",
      "description": "Optional comparison with an independent reference (validation/), e.g. Copernicus EMS.",
      "properties": {
        "reference": {
          "type": "string"
        },
        "reference_date": {
          "type": "string"
        },
        "agreement": {
          "type": "string"
        },
        "share_reference_overlapping_nisar_percent": {
          "type": "number"
        },
        "share_nisar_overlapping_reference_percent": {
          "type": "number"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "scene": {
      "type": "object",
      "required": [
        "scene_id",
        "date",
        "png"
      ],
      "properties": {
        "scene_id": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "png": {
          "type": "string",
          "description": "Greyscale backscatter preview, same bounds as run.bounds."
        },
        "geotiff": {
          "type": "string"
        },
        "polarization": {
          "type": "string",
          "enum": [
            "HH",
            "HV",
            "VH",
            "VV"
          ]
        },
        "product": {
          "type": "string",
          "description": "NISAR product level, e.g. GCOV, GSLC."
        },
        "track_frame": {
          "type": "string"
        }
      }
    }
  }
}
